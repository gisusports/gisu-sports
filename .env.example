# =============================================================================
# GISU SPORTS PLATFORM - SYSTEM CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SUPABASE DATABASE & STORAGE CONFIGURATION
# -----------------------------------------------------------------------------
# Grab these from your Supabase Dashboard: Project Settings -> API
# (Database schema ready in supabase_schema.sql)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# -----------------------------------------------------------------------------
# 2. REAL EMAIL DISPATCH CONFIGURATION (Choose any ONE option below)
# -----------------------------------------------------------------------------

# OPTION A: GMAIL / STANDARD SMTP (Backend delivery via Nodemailer)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM_NAME="Great Ife Sports Council"

# OPTION B: EMAILJS (Client-side, free 200 emails/month, no server required)
# Sign up at https://www.emailjs.com/ and create a service & template
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# OPTION C: RESEND API (3,000 free emails/month - Server-only)
# Sign up at https://resend.com
RESEND_API_KEY=

# OPTION D: BREVO API (formerly Sendinblue - 300 free emails/day - Server-only)
# Sign up at https://brevo.com
BREVO_API_KEY=
BREVO_SENDER_EMAIL=gisusports@gmail.com
BREVO_SENDER_NAME="Great Ife Sports"
